# ============================================================
# OBE Attainment Management System - Environment Variables
# Copy this file to .env and fill in the actual values
# ============================================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME="OBE Attainment Management System"

# Database
DATABASE_URL="mysql://root:password@localhost:3306/obe_attainment_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10mb

# Reports output directory
REPORTS_DIR=./reports

# Admin Seeded Account
SEED_ADMIN_EMAIL=admin@obe.edu
SEED_ADMIN_PASSWORD=Admin@12345

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
