{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": [
      "./node_modules/@types",
      "../../backend/node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "./node_modules/*",
        "../../backend/node_modules/*"
      ]
    }
  },
  "include": ["seed.ts"]
}
